                    att:{
                        className:'finDoxCont'
                    },
                    child:[
                        icon,
                        $({
                            tag:'div',
                            style:{
                                width:'90%',
                                margin:'auto'
                            },
                            child:[
                               $({
                                   tag:'div',
                                   style:{
                                       fontFamily:'arial,sans-serif',
                                       color:'lightskyblue'
                                   },
                                   att:{
                                       innerHTML:`Title: <span style="text-overflow: ellipsis;overflow:hidden;white-space: nowrap; color: #bbb">${title}</span>`
                                   }
                               }),
                                $({
                                    tag:'div',
                                    style:{
                                        fontFamily:'arial,sans-serif',
                                        color:'lightskyblue'
                                    },
                                    att:{
                                        innerHTML:`Status: <span style="text-overflow: ellipsis;overflow:hidden;white-space: nowrap; color: #bbb">${Status}</span>`
                                    }
                                }),

                            ]
                        })
                    ]
                }))
            }

            const content=()=>{
                const getdocs=async (el)=>{
                    const form=new FormData();
                    form.append('finDocs','true')
                    await fetch('/approval',{
                        method:'POST',
                        body:form
                    }).then(res=>res.json())
                        .then(data=>{
                            data.forEach(val=>{
                                el.appendChild(Docs({
                                    title:val.title,
                                    Status:val.status,
                                    id:val.docid
                                }))
                            })
                        })
                }
                return($({
                    tag:'div',
                    style:{
                        width:'100%',
                        height:'91.5%',
                        border:'solid thin rgba(200,200,200,0.2)',
                        margin:'auto',
                        overflowY: 'auto'
                    },
                    elementHandler:getdocs
                }))
            }

            return($({
                tag:'div',
                style:{
                    width:'48%',
                    height:'100%',

                },
                child:[
                    label,
                    content()
                ]
            }))
        }

        return ($({
            tag:'div',
            style:{
                width:'100%',
                display:'flex',
                justifyContent:'center'
            },
            child:[
                $({
                    tag: 'div',
                    att: {
                        className: ' appRovFrame'
                    },
                    child: [
                        header(),
                        container()
                    ]
                }),
                finishedDocs()
            ]
        }))
    }

    const TabList = []
    TabList.push({
        tabButton: Bot({
            text: 'Shared File',
            event: () => {
                window.location.assign('/user/create/share')
            },
            url: '/user/create/share'
        }),
        url: "/user/create/share",
        page: Share
    })
    TabList.push({
        tabButton: Bot({
            text: 'Approval',
            event: () => {
                window.location.assign('/user/create/approval')
            },
            url: '/user/create/approval'
        }),
        url: "/user/create/approval",
        page: Approval
    })
    const getNav = (nav) => {
        TabList.forEach(val => {
            nav.appendChild(val.tabButton)
        })
    }
    const getFrame = (frame) => {
        TabList.forEach(val => {
            if (current === val.url.split('/')[3]) {
                frame.appendChild(val.page())
            }
        })
    }

    const Nav = () => {
        return ($({
            tag: 'div',
            att: {
                className: 'navApp'
            },
            elementHandler: getNav
        }))
    }
    const Frame = () => {


        return ($({
            tag: 'div',
            att: {
                className: 'framesCrea'
            },
            elementHandler: getFrame
        }))
    }


    return ($({
        externalStyle: '/client/component/userComponent/userComponentStyle/create.css',
        tag: 'div',
        att: {
            className: 'createFrame'
        },
        child: [
            Nav(),
            Frame()
        ]

    }))
}
