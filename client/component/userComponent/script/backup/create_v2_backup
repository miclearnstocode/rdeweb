import {$, Request} from '../../../lib/lib.js'





export const ApprovalComponent=()=>{

    const Form=()=>{



        const UploadFile=()=>{

            let file

            return($({

                tag:'div',

                style:{

                    width:'90%',

                    height:'fit-content',

                    margin:'auto',

                    marginTop:'1vh',

                    border:'solid thin #555',

                    padding:'.3rem',

                    display:'flex',
                    backgroundColor:'rgba(0,0,0,0.5)'

                },

                child:[

                    $({

                        tag:'i',

                        att:{

                            className:'fa-solid fa-file-pdf'

                        },

                        style:{

                            fontSize:'1.7vw',

                            color:'deepskyblue'

                        }

                    }),

                    $({

                        tag:'div',

                        style:{

                            width: '90%',

                            marginLeft:'1vw',

                            position:'relative'

                        },

                        child:[

                            $({

                                tag:'input',

                                att:{

                                    type:'file',

                                    accept:'application/pdf',

                                },

                                style:{

                                    visibility:'hidden'

                                },

                                elementHandler:(el)=>{

                                    file=el

                                }

                            }),

                            $({

                                tag:'div',

                                style:{

                                    position:'absolute',

                                    zIndex:'999',

                                    top:'0',

                                    left:'0',

                                    width:'100%',

                                    height: '100%',

                                    cursor:'pointer',

                                    textAlign:'center',

                                    color: '#bbb',

                                    fontFamily:'Segoe UI Historic, Segoe UI, Helvetica, Arial, sans-serif'

                               },

                                event:{

                                    type:'click',

                                    method:()=>{

                                        file.click()

                                    }

                                },

                                text:'Click to Select attachment'

                            })

                        ]

                    })

                ]

            }))

        }

        const SignA=()=>{



            return($({

                tag:'div',

                style:{

                    width:'100%',

                    marginTop: '2vh',

                    color:'#bbb'

                },

                child:[

                    $({

                        tag:'div',

                        att:{

                            innerHTML:'Shared to <i style="font-size:1vw;font-family: monospace"> (Please type and select from the list below)</i>'

                        },

                        style:{

                            width:'90%',

                            margin:'auto',

                            fontFamily:'Segoe UI Historic, Segoe UI, Helvetica, Arial, sans-serif',

                            fontSize:'1vw'

                        }

                    }),

                    $({

                        tag:'div',

                        style:{

                            width:'90%',

                            height:'fit-content',

                            margin:'auto',

                            border:'solid thin #555',

                            padding:'.3rem',

                            display:'flex',
                            backgroundColor:'rgba(0,0,0,0.5)'

                        },

                        child:[

                            $({

                                tag:'i',

                                att:{

                                    className:'fa-solid fa-list'

                                },

                               style:{

                                   fontSize:'1.5vw'

                               }

                            }),

                            $({

                                tag:'input',

                                att:{

                                    type:'search',

                                    placeholder:'Insert text here'

                                },

                                style:{

                                    width:'80%',

                                    marginLeft:'1vw',

                                    backgroundColor:'transparent',

                                    border:'none',

                                    outline:'none',

                                    fontSize:'1vw'

                                },

                                elementHandler:(el)=>{

                                    el.setAttribute('list','shareToDl')

                                },

                            }),

                            $({

                                tag:'div',

                                att:{

                                    className:'fa-solid fa-user-plus'

                                },

                                style:{
                                    margin:'auto',
                                    marginLeft:'2vw',

                                }

                            }),

                            $({

                                tag:'datalist',

                                att:{

                                    id:'shareToDl'

                                },

                                elementHandler:async (dataL)=>{

                                    const form = new FormData()

                                    form.append('allUser', 'true')

                                    await fetch('/loader', {

                                        method: 'POST',

                                        body: form

                                    }).then(res => res.json())

                                        .then(data => {

                                            data.forEach(val => {

                                                dataL.appendChild($({

                                                    tag: 'option',

                                                    att: {

                                                        value: val.fullname,

                                                        id: val.id,

                                                        innerText: val.email,

                                                        status: '',

                                                        signature: {

                                                            locationX: '',

                                                            locationY: ''

                                                        }

                                                    }

                                                }))

                                            })

                                        })

                                }

                            })

                        ]

                    })

                ]

            }))

        }

        const SignB=()=>{



            return($({

                tag:'div',

                style:{

                    width:'100%',

                    marginTop: '2vh',

                    color:'#bbb'

                },

                child:[

                    $({

                        tag:'div',

                        att:{

                            innerHTML:'Recommending Approval <i style="font-size:1vw;font-family: monospace"> (Please type and select from the list below)</i>'

                        },

                        style:{

                            width:'90%',

                            margin:'auto',

                            fontFamily:'Segoe UI Historic, Segoe UI, Helvetica, Arial, sans-serif',

                            fontSize:'1vw'

                        }

                    }),

                    $({

                        tag:'div',

                        style:{

                            width:'90%',

                            height:'fit-content',

                            margin:'auto',

                            border:'solid thin #555',

                            padding:'.3rem',

                            display:'flex',
                            backgroundColor:'rgba(0,0,0,0.5)'

                        },

                        child:[

                            $({

                                tag:'div',

                                att:{

                                    className:'fa-solid fa-person-circle-check'

                                },

                                style:{

                                    fontSize:'1.5vw',
                                    margin:'auto',
                                    height:'fit-content',

                                }

                            }),

                            $({

                                tag:'input',

                                att:{

                                    type:'search',

                                    placeholder:'Insert text here'

                                },

                                style:{

                                    width:'91%',

                                    marginLeft:'1vw',

                                    backgroundColor:'transparent',

                                    border:'none',

                                    outline:'none',

                                    fontSize:'1vw'

                                },

                                elementHandler:(el)=>{

                                    el.setAttribute('list','appDl')

                                },

                            }),



                            $({

                                tag:'datalist',

                                att:{

                                    id:'appDl'

                                },

                                elementHandler:async (dataL)=>{

                                    const form = new FormData()

                                    form.append('allUser', 'true')

                                    await fetch('/loader', {

                                        method: 'POST',

                                        body: form

                                    }).then(res => res.json())

                                        .then(data => {

                                            data.forEach(val => {

                                                dataL.appendChild($({

                                                    tag: 'option',

                                                    att: {

                                                        value: val.fullname,

                                                        id: val.id,

                                                        innerText: val.email,

                                                        status: '',

                                                        signature: {

                                                            locationX: '',

                                                            locationY: ''

                                                        }

                                                    }

                                                }))

                                            })

                                        })

                                }

                            })

                        ]

                    })

                ]

            }))

        }
        const DocType=()=>{
            return($({

                tag:'div',

                style:{

                    width:'100%',

                    marginTop: '2vh',

                    color:'#bbb'

                },

                child:[

                    $({

                        tag:'div',

                        att:{

                            innerHTML:'Document Type <i style="font-size:1vw;font-family: monospace"> (Please select from the list below)</i>'

                        },

                        style:{

                            width:'90%',

                            margin:'auto',

                            fontFamily:'Segoe UI Historic, Segoe UI, Helvetica, Arial, sans-serif',

                            fontSize:'1vw'

                        }

                    }),

                    $({

                        tag:'div',

                        style:{

                            width:'90%',

                            height:'fit-content',

                            margin:'auto',

                            border:'solid thin #555',

                            padding:'.3rem',

                            display:'flex',
                            backgroundColor:'rgba(0,0,0,0.5)'

                        },

                        child:[

                            $({

                                tag:'div',

                                att:{

                                    className:'fa-solid fa-file-circle-question'

                                },

                                style:{

                                    fontSize:'1.5vw',
                                    margin:'auto',
                                    height:'fit-content',

                                }

                            }),

                            $({

                                tag:'select',

                                att:{

                                },

                                style:{

                                    width:'91%',

                                    marginLeft:'1vw',

                                    backgroundColor:'transparent',

                                    border:'none',

                                    outline:'none',

                                    fontSize:'1vw',
                                    color:'#bbb'

                                },

                                elementHandler:(el)=>{
                                    el.appendChild($({
                                        tag:'option',
                                        att:{
                                            selected:true,
                                            disabled:true,
                                            innerText:'- - Select Document Type - -',
                                            id:'0'
                                        }
                                    }))

                                    const req= new Request('/getDocType')
                                    req.Post([
                                        {
                                            name:'getDoctype',
                                            value:'1'
                                        }
                                    ])
                                    req.Json()
                                    req.Send().then(data=>{
                                        data.forEach(val=>{
                                            el.appendChild($({
                                                tag:'option',
                                                att:{
                                                    innerText:val.name,
                                                    className:'optionDoctype'
                                                }
                                            }))
                                        })
                                    })
                                },


                            }),





                        ]

                    })

                ]

            }))
        }
        const Submit=()=>{

            return($({

                tag:'div',

                att:{

                    className:'SubmitApproval'
                },
                child:[
                    $({
                        tag:'input',
                        att:{
                            type:'submit',
                            value:'Submit'
                        }
                    })
                ]

            }))

        }
        return($({

            tag:'form',

            att:{

                action:'/'

            },

            event:{

                type:"submit",

                method:(eve)=>{
                    eve.preventDefault();
                }

            },

            child:[

                UploadFile(),

                SignA(),

                SignB(),
                DocType(),
                Submit()

            ]

        }))

    }

    return($({

        tag:'div',

        child:[

            Form()

        ]

    }))

}