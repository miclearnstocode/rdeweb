                                // Title of Research with search (for add mode)
                                ...(isAddMode ? [
                                    $({
                                        tag: 'div',
                                        style: { marginBottom: '20px' },
                                        child: [
                                            $({
                                                tag: 'label',
                                                text: 'Title of Research *',
                                                style: {
                                                    display: 'block',
                                                    marginBottom: '8px',
