                                justifyContent: 'space-between',
                                alignItems: 'center',
                                position: 'sticky',
                                top: '0',
                                backgroundColor: '#2d2d2d',
                                zIndex: '1'
                            },
                            child: [
                                $({
                                    tag: 'h2',
                                    text: isViewMode ? 'View Presentation' : (isEditMode ? 'Edit Presentation' : 'Add New Presentation'),
