RewriteEngine On
RewriteBase /

# Don't rewrite PHP files - let them execute
RewriteCond %{REQUEST_URI} \.php$ [NC]
RewriteRule ^ - [L]

# Don't rewrite existing files
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Don't rewrite existing directories
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route everything else to routes.php
RewriteRule ^(.*)$ server/routes.php [QSA,L]