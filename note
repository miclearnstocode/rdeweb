CREATE TABLE center (
    id        INT AUTO_INCREMENT PRIMARY KEY,
    code      VARCHAR(20)  NOT NULL,  -- e.g. 'CSRDC'
    name      VARCHAR(255) NOT NULL   -- optional full name
);
Insered the values for center check the table in XAMMPP phpmyadmin

CREATE TABLE center_category (
    center_id   INT NOT NULL,
    category_id INT NOT NULL,
    PRIMARY KEY (center_id, category_id),
    CONSTRAINT fk_center_category_center
        FOREIGN KEY (center_id) REFERENCES center(id),
    CONSTRAINT fk_center_category_category
        FOREIGN KEY (category_id) REFERENCES category(id)
);
