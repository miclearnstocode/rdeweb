-- migration_drive.sql
ALTER TABLE researchfile 
ADD COLUMN drive_file_id VARCHAR(255),
ADD COLUMN drive_view_url VARCHAR(500),
ADD COLUMN drive_download_url VARCHAR(500),
ADD COLUMN drive_folder_id VARCHAR(255),
ADD COLUMN drive_event_folder_id VARCHAR(255),
ADD COLUMN drive_center_folder_id VARCHAR(255);

ALTER TABLE endorsement 
ADD COLUMN drive_file_id VARCHAR(255),
ADD COLUMN drive_view_url VARCHAR(500),
ADD COLUMN drive_download_url VARCHAR(500);

ALTER TABLE files 
ADD COLUMN drive_file_id VARCHAR(255),
ADD COLUMN drive_view_url VARCHAR(500);

ALTER TABLE chat_file 
ADD COLUMN drive_file_id VARCHAR(255),
ADD COLUMN drive_view_url VARCHAR(500);

ALTER TABLE systemfiles 
ADD COLUMN drive_file_id VARCHAR(255),
ADD COLUMN drive_view_url VARCHAR(500);

-- Add indexes for faster lookups
CREATE INDEX idx_drive_file_id ON researchfile(drive_file_id);
CREATE INDEX idx_drive_folder_id ON researchfile(drive_folder_id);
CREATE INDEX idx_drive_file_id_endorsement ON endorsement(drive_file_id);


